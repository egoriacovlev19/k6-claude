# Шаблон переменных окружения. Скопируйте в .env.k6_performance и впишите значения —
# тот файл в .gitignore и в репозиторий не попадёт.
#
# Альтернатива файлу: задать те же переменные в системных переменных окружения
# (Windows: System Environment Variables; macOS/Linux: export в ~/.zshrc или ~/.bashrc).
# Системные переменные имеют приоритет над файлом.
#
# Формат: KEY=VALUE, без пробелов вокруг "=". Пустое значение = берётся значение по умолчанию.
#
# ВАЖНО: логины и пароли тестовых аккаунтов сюда НЕ кладутся — это тест-данные,
# их место в projects/<name>/data/*.csv (см. docs/README.md).
# Здесь — только настройки окружения и инфраструктуры.

# --- Инструменты ---

# Путь к бинарнику k6, если его нет в PATH (Windows: C:\Program Files\k6\k6.exe). По умолчанию: k6.
K6_PERFORMANCE_K6_BINARY=

# true — запускать браузер видимым (для отладки теста). По умолчанию: без окна (headless).
K6_PERFORMANCE_HEADED=

# --- Локальный Docker-стек (docker-compose.yml) ---

# Логин и пароль администратора Grafana. По умолчанию: стандартный вход Grafana.
K6_PERFORMANCE_GRAFANA_ADMIN_USER=
K6_PERFORMANCE_GRAFANA_ADMIN_PASSWORD=

# Порты на машине (127.0.0.1), если стандартные заняты. По умолчанию: 3000, 9090, 9100.
K6_PERFORMANCE_GRAFANA_PORT=
K6_PERFORMANCE_PROMETHEUS_PORT=
K6_PERFORMANCE_METRICS_EXPORTER_PORT=
